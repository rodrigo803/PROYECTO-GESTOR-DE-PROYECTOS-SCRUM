<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gestor_proyectos_scrum.Api</RootNamespace>
    <UserSecretsId>1351ad6f-0078-4227-a1fa-f6c1e7dd655e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <!--
    Cuando el MVC referencia este proyecto para montarlo en una sola app (Plesk),
    dotnet publish choca porque ambos proyectos tienen su propio appsettings.json
    con la misma ruta relativa. El de esta Api solo trae Cors/AllowedHosts, y el
    código ya cae a esos mismos valores por defecto si el archivo no existe, así
    que no se publica (dotnet run local de la Api sola no cambia: sigue
    copiándose a bin/ con CopyToOutputDirectory).
  -->
  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
