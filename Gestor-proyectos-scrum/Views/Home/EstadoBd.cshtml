@model Gestor_proyectos_scrum.Models.EstadoBdViewModel
@{
    ViewData["Title"] = "Estado de la base de datos";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
    <h1 class="page-title mb-0">Estado de la base de datos</h1>
</div>

@if (Model.Conectado)
{
    <div class="alert alert-success d-flex align-items-center" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div>Conectado a <strong>ScrumDb</strong> correctamente.</div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-custom p-3">
                <span class="text-muted small fw-medium">Tablas</span>
                <h3 class="fw-bold text-dark mt-1 mb-0">@Model.Tablas</h3>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-custom p-3">
                <span class="text-muted small fw-medium">Vistas</span>
                <h3 class="fw-bold text-dark mt-1 mb-0">@Model.Vistas</h3>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-custom p-3">
                <span class="text-muted small fw-medium">Triggers</span>
                <h3 class="fw-bold text-dark mt-1 mb-0">@Model.Triggers</h3>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-custom p-3">
                <span class="text-muted small fw-medium">Registros en Proyectos</span>
                <h3 class="fw-bold text-dark mt-1 mb-0">@Model.RegistrosProyectos</h3>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger" role="alert">
        <div class="d-flex align-items-center mb-1">
            <i class="bi bi-x-circle-fill me-2"></i>
            <strong>No se pudo conectar a la base de datos.</strong>
        </div>
        <p class="small mb-0">@Model.Error</p>
    </div>
}
