@model Gestor_proyectos_scrum.Models.CrearSprintViewModel
@{
    ViewData["Title"] = "Crear Nuevo Sprint";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modulos-rodrigo.css" asp-append-version="true" />
}

@await Html.PartialAsync("_BarraPerfilPruebas")

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-controller="Sprints" asp-action="Index" class="text-decoration-none text-muted">Gestión de Sprints</a></li>
                <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">Crear Nuevo Sprint</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <h1 class="page-title mb-0">Planificar Nuevo Sprint</h1>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">HU-05</span>
        </div>
        <p class="page-subtitle mb-0">Configura el período de iteración, objetivo y capacidad en puntos de historia.</p>
    </div>

    <div>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i>
            <span>Volver al listado</span>
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card-custom p-4">
            <form asp-action="Create" method="post" class="form-validar-scrum" data-scrum-form="sprint" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small" role="alert"></div>

                <div class="row g-3">
                    <!-- Proyecto -->
                    <div class="col-12">
                        <label asp-for="IdProyecto" class="form-label fw-semibold text-dark"></label>
                        <span class="text-danger">*</span>
                        <select asp-for="IdProyecto"
                                class="form-select"
                                id="selectProyectoSprint"
                                required
                                data-msg-required="Seleccione un proyecto válido.">
                            @foreach (var p in Model.ProyectosDisponibles)
                            {
                                <option value="@p.IdProyecto"
                                        data-inicio="@p.FechaInicio.ToString("yyyy-MM-dd")"
                                        data-fin="@p.FechaFin.ToString("yyyy-MM-dd")">
                                    @p.Codigo — @p.Nombre (Vigencia: @p.FechaInicio.ToString("dd/MM/yyyy") al @p.FechaFin.ToString("dd/MM/yyyy") · @p.Estado)
                                </option>
                            }
                        </select>
                        <div class="form-text" id="rangoProyectoAyuda">
                            Las fechas del Sprint deben estar dentro de la vigencia del proyecto seleccionado.
                        </div>
                        <span asp-validation-for="IdProyecto" class="text-danger small"></span>
                    </div>

                    <!-- Nombre del Sprint -->
                    <div class="col-12 col-md-8">
                        <label asp-for="Nombre" class="form-label fw-semibold text-dark"></label>
                        <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-tag text-muted"></i></span>
                            <input asp-for="Nombre"
                                   class="form-control"
                                   maxlength="60"
                                   placeholder="ej. Sprint 3 - Notificaciones y Reportes"
                                   required
                                   data-msg-required="El nombre del Sprint es obligatorio." />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <!-- Capacidad en Puntos -->
                    <div class="col-12 col-md-4">
                        <label asp-for="CapacidadPuntos" class="form-label fw-semibold text-dark"></label>
                        <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-speedometer text-muted"></i></span>
                            <input asp-for="CapacidadPuntos"
                                   type="number"
                                   min="1"
                                   max="1000"
                                   class="form-control"
                                   required
                                   data-msg-required="La capacidad en puntos es obligatoria."
                                   data-msg-min="La capacidad estimada debe ser mayor a 0." />
                            <span class="input-group-text bg-light text-muted small">pts</span>
                        </div>
                        <span asp-validation-for="CapacidadPuntos" class="text-danger small"></span>
                    </div>

                    <!-- Fechas Inicio y Fin -->
                    <div class="col-12 col-md-6">
                        <label asp-for="FechaInicio" class="form-label fw-semibold text-dark"></label>
                        <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-calendar-check text-muted"></i></span>
                            <input asp-for="FechaInicio"
                                   type="date"
                                   class="form-control"
                                   required
                                   data-msg-required="La fecha de inicio es obligatoria." />
                        </div>
                        <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="FechaFin" class="form-label fw-semibold text-dark"></label>
                        <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-calendar-x text-muted"></i></span>
                            <input asp-for="FechaFin"
                                   type="date"
                                   class="form-control"
                                   required
                                   data-msg-required="La fecha de finalización es obligatoria." />
                        </div>
                        <span asp-validation-for="FechaFin" class="text-danger small"></span>
                    </div>

                    <!-- Objetivo del Sprint -->
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Objetivo" class="form-label fw-semibold text-dark mb-1"></label>
                            <span id="contadorObjetivoCreatePage" class="char-counter">0 / 300</span>
                        </div>
                        <textarea asp-for="Objetivo"
                                  rows="3"
                                  maxlength="300"
                                  data-char-counter="#contadorObjetivoCreatePage"
                                  class="form-control"
                                  placeholder="Describe claramente el incremento de valor que entregará este Sprint..."
                                  required
                                  data-msg-required="El objetivo del Sprint es obligatorio."></textarea>
                        <div class="form-text">El Sprint se creará en estado <strong>Planificado</strong> para que luego puedas comprometer Historias de Usuario e iniciarlo.</div>
                        <span asp-validation-for="Objetivo" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4">
                        <i class="bi bi-save"></i>
                        <span>Guardar Sprint</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modulos-rodrigo.js" asp-append-version="true"></script>
}
