@model Gestor_proyectos_scrum.Models.ProyectosIndexViewModel
@{
    ViewData["Title"] = "Gestión de Proyectos";

    var sinPoOSm = Model.Proyectos
        .Where(p => string.IsNullOrEmpty(p.ProductOwner) || string.IsNullOrEmpty(p.ScrumMaster))
        .ToList();
}

@functions {
    private static string ClaseEstado(string estado) => estado switch
    {
        "Activo" => "project-status-activo",
        "Planificado" => "project-status-planificado",
        "En pausa" => "project-status-pausa",
        "Cerrado" => "project-status-cerrado",
        _ => "project-status-planificado"
    };
}

<!-- Encabezado de la Pantalla -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">Gestión de Proyectos</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="page-title mb-0">Gestión de Proyectos</h1>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">HU-03</span>
        </div>
        <p class="page-subtitle mb-0">Crea, consulta, modifica y cierra los proyectos SCRUM de la organización.</p>
    </div>

    <div class="d-flex flex-column align-items-lg-end gap-2">
        <a asp-action="Crear" class="btn btn-primary d-flex align-items-center gap-2 py-2 px-3 shadow-sm">
            <i class="bi bi-plus-circle-fill fs-5"></i>
            <span class="fw-medium">Nuevo Proyecto</span>
        </a>
    </div>
</div>

@if (sinPoOSm.Any())
{
    <div class="alert alert-warning d-flex align-items-start gap-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        <div class="flex-grow-1">
            <div class="fw-bold">
                @(sinPoOSm.Count == 1 ? "1 proyecto no tiene" : $"{sinPoOSm.Count} proyectos no tienen") Product Owner o Scrum Master asignado
            </div>
            <p class="small mb-1">
                Regla de negocio: todo proyecto debe tener al menos un <strong>Product Owner</strong> y un <strong>Scrum Master</strong>
                antes de pasar a estado "Activo".
            </p>
            <ul class="small mb-0">
                @foreach (var p in sinPoOSm)
                {
                    var falta = new List<string>();
                    if (string.IsNullOrEmpty(p.ProductOwner)) { falta.Add("Product Owner"); }
                    if (string.IsNullOrEmpty(p.ScrumMaster)) { falta.Add("Scrum Master"); }

                    <li><a href="#fila-@p.Codigo" class="text-decoration-none"><strong>@p.Nombre</strong> (@p.Codigo)</a> &mdash; sin @string.Join(" y ", falta)</li>
                }
            </ul>
        </div>
    </div>
}

<!-- Tarjetas de Métricas -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card d-flex align-items-start justify-content-between">
            <div>
                <div class="metric-card-label">Proyectos Totales</div>
                <div class="metric-card-value">@Model.Metricas.Total</div>
                <div class="metric-card-footnote">Portafolio completo</div>
            </div>
            <div class="metric-card-icon metric-card-icon-indigo"><i class="bi bi-kanban"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card d-flex align-items-start justify-content-between">
            <div>
                <div class="metric-card-label">Proyectos Activos</div>
                <div class="metric-card-value">@Model.Metricas.Activos</div>
                <div class="metric-card-footnote">En ejecución actualmente</div>
            </div>
            <div class="metric-card-icon metric-card-icon-teal"><i class="bi bi-play-circle"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card d-flex align-items-start justify-content-between">
            <div>
                <div class="metric-card-label">En Planificación</div>
                <div class="metric-card-value">@Model.Metricas.Planificados</div>
                <div class="metric-card-footnote">Antes de iniciar Sprint 1</div>
            </div>
            <div class="metric-card-icon metric-card-icon-amber"><i class="bi bi-hourglass-split"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card d-flex align-items-start justify-content-between">
            <div>
                <div class="metric-card-label">Proyectos Cerrados</div>
                <div class="metric-card-value">@Model.Metricas.Cerrados</div>
                <div class="metric-card-footnote">Entregados al 100%</div>
            </div>
            <div class="metric-card-icon metric-card-icon-rose"><i class="bi bi-archive"></i></div>
        </div>
    </div>
</div>

<!-- Panel Principal: Listado de Proyectos -->
<div class="card-custom overflow-hidden">

    <!-- Barra de Filtros y Búsqueda -->
    <div class="p-3 border-bottom d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 bg-light bg-opacity-50">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0 fw-bold fs-6 text-dark">Listado de Proyectos</h5>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill">@Model.Proyectos.Count registrados</span>
        </div>
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 flex-wrap">
            <div class="input-group input-group-sm" style="max-width: 240px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="buscar" value="@Model.Buscar" class="form-control border-start-0" placeholder="Buscar proyecto..." aria-label="Buscar proyecto">
            </div>
            <select name="estado" class="form-select form-select-sm" style="max-width: 160px;" aria-label="Filtrar por estado" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Estado))">Todos los estados</option>
                <option value="Planificado" selected="@(Model.Estado == "Planificado")">Planificado</option>
                <option value="Activo" selected="@(Model.Estado == "Activo")">Activo</option>
                <option value="En pausa" selected="@(Model.Estado == "En pausa")">En pausa</option>
                <option value="Cerrado" selected="@(Model.Estado == "Cerrado")">Cerrado</option>
            </select>
            <select name="orden" class="form-select form-select-sm" style="max-width: 170px;" aria-label="Ordenar por" onchange="this.form.submit()">
                <option value="nombre" selected="@(string.IsNullOrEmpty(Model.Orden) || Model.Orden == "nombre")">Ordenar: Nombre</option>
                <option value="inicio" selected="@(Model.Orden == "inicio")">Ordenar: Fecha inicio</option>
                <option value="avance" selected="@(Model.Orden == "avance")">Ordenar: Avance</option>
                <option value="estado" selected="@(Model.Orden == "estado")">Ordenar: Estado</option>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Filtrar" aria-label="Filtrar">
                <i class="bi bi-funnel"></i>
            </button>
        </form>
    </div>

    <!-- Tabla Responsive (Escritorio / Tablet) -->
    <div class="table-responsive d-none d-md-block">
        <table class="table table-custom table-hover mb-0">
            <thead>
                <tr>
                    <th scope="col" style="min-width: 170px;">Proyecto</th>
                    <th scope="col" class="d-none d-xl-table-cell" style="min-width: 130px;">Fechas</th>
                    <th scope="col" style="min-width: 110px;">Product Owner</th>
                    <th scope="col" style="min-width: 110px;">Scrum Master</th>
                    <th scope="col" style="min-width: 90px;">Miembros</th>
                    <th scope="col" style="min-width: 100px;">Avance</th>
                    <th scope="col" style="min-width: 95px;">Estado</th>
                    <th scope="col" class="text-end" style="min-width: 95px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Proyectos.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No se encontraron proyectos con estos filtros.</td>
                    </tr>
                }
                @foreach (var p in Model.Proyectos)
                {
                    <tr id="fila-@p.Codigo" class="@(string.IsNullOrEmpty(p.ProductOwner) || string.IsNullOrEmpty(p.ScrumMaster) ? "table-warning" : "")">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="p-2 rounded bg-primary-subtle text-primary"><i class="bi bi-kanban fs-5"></i></div>
                                <div>
                                    <div class="fw-bold text-dark">@p.Nombre</div>
                                    <small class="text-muted">@p.Codigo</small>
                                </div>
                            </div>
                        </td>
                        <td class="d-none d-xl-table-cell">
                            <div class="d-flex flex-column small">
                                <span class="text-dark fw-medium">@p.FechaInicio.ToString("dd/MM/yyyy") &mdash; @p.FechaFin.ToString("dd/MM/yyyy")</span>
                            </div>
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(p.ProductOwner))
                            {
                                <span class="small text-danger fw-semibold"><i class="bi bi-exclamation-circle-fill me-1"></i>Sin asignar</span>
                            }
                            else
                            {
                                <span class="small text-dark">@p.ProductOwner</span>
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(p.ScrumMaster))
                            {
                                <span class="small text-danger fw-semibold"><i class="bi bi-exclamation-circle-fill me-1"></i>Sin asignar</span>
                            }
                            else
                            {
                                <span class="small text-dark">@p.ScrumMaster</span>
                            }
                        </td>
                        <td>
                            @if (p.CantidadMiembros > 0)
                            {
                                <div class="avatar-stack avatar-stack-sm" title="@p.CantidadMiembros miembro(s)">
                                    @foreach (var inicial in p.InicialesMiembros)
                                    {
                                        <div class="avatar-stack-item bg-primary">@inicial</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="small text-muted">Sin miembros</span>
                            }
                        </td>
                        <td>
                            <div class="small fw-semibold text-dark mb-1">@p.Avance.ToString("0")%</div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar @(p.Avance >= 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @(p.Avance.ToString("0"))%;" aria-valuenow="@p.Avance.ToString("0")" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </td>
                        <td>
                            <span class="project-status-badge @ClaseEstado(p.Estado)"><span class="status-dot"></span>@p.Estado</span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Detalle" asp-route-id="@p.IdProyecto" class="btn btn-outline-primary" title="Ver detalle" aria-label="Ver detalle del proyecto">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Editar" asp-route-id="@p.IdProyecto" class="btn btn-outline-secondary" title="Editar proyecto" aria-label="Editar proyecto">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (p.Estado != "Cerrado")
                                {
                                    <a asp-action="Cerrar" asp-route-id="@p.IdProyecto" class="btn btn-outline-danger" title="Cerrar proyecto" aria-label="Cerrar proyecto">
                                        <i class="bi bi-slash-circle"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Tarjetas Responsive (Móvil) -->
    <div class="d-md-none p-3 d-flex flex-column gap-3">
        @if (!Model.Proyectos.Any())
        {
            <p class="text-center text-muted py-3 mb-0">No se encontraron proyectos con estos filtros.</p>
        }
        @foreach (var p in Model.Proyectos)
        {
            <div class="card-custom p-3 @(string.IsNullOrEmpty(p.ProductOwner) || string.IsNullOrEmpty(p.ScrumMaster) ? "border-start border-4 border-warning" : "")">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <div class="fw-bold text-dark">@p.Nombre</div>
                        <small class="text-muted">@p.Codigo</small>
                    </div>
                    <span class="project-status-badge @ClaseEstado(p.Estado)"><span class="status-dot"></span>@p.Estado</span>
                </div>
                <div class="small text-muted mb-2"><i class="bi bi-calendar-event me-1"></i>@p.FechaInicio.ToString("dd/MM/yyyy") &mdash; @p.FechaFin.ToString("dd/MM/yyyy")</div>
                <div class="small mb-1">
                    <strong>PO:</strong> @(string.IsNullOrEmpty(p.ProductOwner) ? "Sin asignar" : p.ProductOwner)
                    &nbsp;|&nbsp;
                    <strong>SM:</strong> @(string.IsNullOrEmpty(p.ScrumMaster) ? "Sin asignar" : p.ScrumMaster)
                </div>
                @if (p.CantidadMiembros > 0)
                {
                    <div class="avatar-stack avatar-stack-sm mb-2">
                        @foreach (var inicial in p.InicialesMiembros)
                        {
                            <div class="avatar-stack-item bg-primary">@inicial</div>
                        }
                    </div>
                }
                <div class="progress mb-1" style="height: 6px;">
                    <div class="progress-bar @(p.Avance >= 100 ? "bg-success" : "bg-primary")" style="width: @(p.Avance.ToString("0"))%;"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Avance: @p.Avance.ToString("0")%</small>
                    <div class="btn-group btn-group-sm">
                        <a asp-action="Detalle" asp-route-id="@p.IdProyecto" class="btn btn-outline-primary" aria-label="Ver detalle del proyecto"><i class="bi bi-eye"></i></a>
                        <a asp-action="Editar" asp-route-id="@p.IdProyecto" class="btn btn-outline-secondary" aria-label="Editar proyecto"><i class="bi bi-pencil"></i></a>
                        @if (p.Estado != "Cerrado")
                        {
                            <a asp-action="Cerrar" asp-route-id="@p.IdProyecto" class="btn btn-outline-danger" aria-label="Cerrar proyecto"><i class="bi bi-slash-circle"></i></a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

</div>
