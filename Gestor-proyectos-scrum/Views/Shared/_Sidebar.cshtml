@inject Gestor_proyectos_scrum.Services.UsuarioActual UsuarioActual
@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string EsActivo(string controlador) => controladorActual.Equals(controlador, StringComparison.OrdinalIgnoreCase) ? " active" : "";
}

<!-- ========================================== -->
<!-- SIDEBAR ADMINISTRATIVO                      -->
<!-- ========================================== -->
<aside class="admin-sidebar" id="adminSidebar">

    <div class="sidebar-heading">Navegación Principal</div>
    <nav class="nav flex-column mb-3">
        <a asp-controller="Home" asp-action="Index" class="sidebar-nav-link@(EsActivo("Home"))">
            <i class="bi bi-grid-1x2"></i>
            <span>Dashboard</span>
        </a>
        @if (UsuarioActual.Rol == Gestor_proyectos_scrum.Services.Permisos.Administrador)
        {
            <a asp-controller="Usuarios" asp-action="Index" class="sidebar-nav-link@(EsActivo("Usuarios"))">
                <i class="bi bi-people"></i>
                <span>Gestión de Usuarios</span>
            </a>
        }
        <a asp-controller="Proyectos" asp-action="Index" class="sidebar-nav-link@(EsActivo("Proyectos"))">
            <i class="bi bi-kanban"></i>
            <span>Gestión de Proyectos</span>
        </a>
        <a asp-controller="Backlog" asp-action="Index" class="sidebar-nav-link@(EsActivo("Backlog"))">
            <i class="bi bi-journal-text"></i>
            <span>Product Backlog</span>
        </a>
        <a asp-controller="Sprints" asp-action="Index" class="sidebar-nav-link@(EsActivo("Sprints"))">
            <i class="bi bi-arrow-repeat"></i>
            <span>Gestión de Sprints</span>
        </a>
        <a asp-controller="Planificacion" asp-action="Index" class="sidebar-nav-link@(EsActivo("Planificacion"))">
            <i class="bi bi-calendar2-week"></i>
            <span>Planificación del Sprint</span>
        </a>
        <a asp-controller="Tareas" asp-action="Index" class="sidebar-nav-link@(EsActivo("Tareas"))">
            <i class="bi bi-card-checklist"></i>
            <span>Sprint Backlog</span>
        </a>
        <a asp-controller="Tablero" asp-action="Index" class="sidebar-nav-link@(EsActivo("Tablero"))">
            <i class="bi bi-columns-gap"></i>
            <span>Tablero Kanban</span>
        </a>
        <a asp-controller="Impedimentos" asp-action="Index" class="sidebar-nav-link@(EsActivo("Impedimentos"))">
            <i class="bi bi-cone-striped"></i>
            <span>Impedimentos</span>
        </a>
        <a asp-controller="Retrospectivas" asp-action="Index" class="sidebar-nav-link@(EsActivo("Retrospectivas"))">
            <i class="bi bi-chat-square-text"></i>
            <span>Retrospectiva</span>
        </a>
    </nav>

    <!-- Botón Cerrar Sesión en pie del Sidebar -->
    <div class="mt-auto px-3 pt-4">
        <button class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-2" type="button" onclick="confirmarCierreSesion()">
            <i class="bi bi-box-arrow-right"></i>
            <span>Cerrar Sesión</span>
        </button>
    </div>

</aside>
