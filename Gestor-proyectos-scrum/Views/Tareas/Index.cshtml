<!-- MODAL OSCURO: REGISTRAR CHECKPOINT INMUTABLE (AvanceTareas)-->
<!-- ========================================================= -->
<div class="modal fade" id="modalRegistrarAvance" tabindex="-1" aria-labelledby="modalRegistrarAvanceLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white px-4 py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary p-2 rounded text-white">
                        <i class="bi bi-graph-up-arrow fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold fs-5 mb-0" id="modalRegistrarAvanceLabel">Registrar Checkpoint Inmutable</h5>
                        <small class="text-light text-opacity-75" id="modalCheckpointSubtitulo">Tarea</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form asp-action="RegistrarAvance" method="post" id="formModalCheckpoint" class="form-validar-scrum" data-scrum-form="checkpoint" data-pct-actual="0" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdTarea" id="chkIdTarea" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="modal-body p-4">
                    <div class="d-flex align-items-center justify-content-between p-2 px-3 mb-2 rounded-3 bg-light border small">
                        <span>Situación actual registrada:</span>
                        <span>
                            <strong class="text-primary fs-6" id="chkPorcentajeAnteriorTexto">0%</strong>
                            <span class="badge bg-white text-dark border ms-1" id="chkEstadoAnteriorTexto">Pendiente</span>
                        </span>
                    </div>

                    <div class="alert alert-light border small py-2 px-3 mb-3 text-muted">
                        <i class="bi bi-shield-lock text-primary me-1"></i>
                        Los checkpoints de avance son <strong>inmutables</strong>: una vez guardados quedan en la bitácora y no pueden editarse ni eliminarse.
                    </div>

                    <div id="chkAlertaModal" class="alert alert-warning rounded-3 small d-none mb-3 alerta-validacion-scrum"></div>

                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold text-dark small">Nuevo Avance (%) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number"
                                       name="PorcentajeNuevo"
                                       id="chkPorcentajeNuevo"
                                       class="form-control fw-bold"
                                       min="0"
                                       max="100"
                                       required
                                       data-msg-required="Ingrese el nuevo porcentaje de avance (0 a 100)."
                                       data-msg-min="El porcentaje no puede ser menor a 0%."
                                       data-msg-max="El porcentaje no puede superar 100%." />
                                <span class="input-group-text bg-light">%</span>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold text-dark small">Horas Trabajadas <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number"
                                       name="HorasTrabajadas"
                                       id="chkHorasTrabajadas"
                                       class="form-control"
                                       value="2"
                                       step="0.5"
                                       min="0"
                                       max="500"
                                       required
                                       data-msg-required="Ingrese las horas trabajadas (0 o mayor)."
                                       data-msg-min="Las horas trabajadas no pueden ser negativas." />
                                <span class="input-group-text bg-light">hrs</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark small">Nuevo Estado <span class="text-danger">*</span></label>
                            <select name="EstadoNuevo" id="chkEstadoNuevo" class="form-select" required data-msg-required="Seleccione el nuevo estado de la tarea.">
                                <option value="Pendiente">Pendiente</option>
                                <option value="En progreso">En progreso</option>
                                <option value="En revisión">En revisión</option>
                                <option value="Finalizado">Finalizado (100%)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label fw-semibold text-dark small mb-1">
                                    Justificación / Notas
                                    <span id="chkAsteriscoJust" class="text-danger d-none">* (Obligatorio por retroceso)</span>
                                </label>
                                <span id="contadorChkJustModal" class="char-counter">0 / 300</span>
                            </div>
                            <textarea name="Justificacion"
                                      id="chkJustificacion"
                                      rows="2"
                                      maxlength="300"
                                      data-char-counter="#contadorChkJustModal"
                                      class="form-control"
                                      placeholder="Describe el avance o justifica cualquier disminución del porcentaje..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark small">Impedimento Relacionado (opcional)</label>
                            <select name="IdImpedimento" id="chkIdImpedimento" class="form-select form-select-sm">
                                <option value="">-- Ningún impedimento vinculado --</option>
                                @foreach (var imp in Model.ImpedimentosActivos)
                                {
                                    <option value="@imp.IdImpedimento">[#@imp.IdImpedimento · @imp.Severidad] @imp.Titulo</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check"></i>
                        <span>Registrar Checkpoint</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

