<!-- MODAL OSCURO: CONFIRMAR ELIMINAR TAREA                    -->
<!-- ========================================================= -->
<div class="modal fade" id="modalConfirmarEliminarTarea" tabindex="-1" aria-labelledby="modalConfirmarEliminarTareaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white px-4 py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-danger p-2 rounded text-white">
                        <i class="bi bi-trash fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold fs-5 mb-0" id="modalConfirmarEliminarTareaLabel">Eliminar Tarea Técnica</h5>
                        <small class="text-light text-opacity-75">Solo permitido para tareas sin historial de checkpoints</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form asp-action="Eliminar" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="eliminarIdTarea" />
                <input type="hidden" name="idSprintRetorno" value="@Model.IdSprintFiltro" />

                <div class="modal-body p-4">
                    <p class="mb-0 text-dark" id="eliminarTareaTexto">
                        ¿Confirmas la eliminación de esta tarea?
                    </p>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger d-flex align-items-center gap-2">
                        <i class="bi bi-trash"></i>
                        <span>Eliminar Tarea</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modulos-rodrigo.js" asp-append-version="true"></script>
    <script>
        let pctAnteriorModal = 0;

        function prepararModalAgregarTarea(idSprintHistoria, etiquetaHu) {
            const sel = document.getElementById('crearTareaIdSprintHistoria');
            if (sel && idSprintHistoria) {
                sel.value = idSprintHistoria;
            }
            const sub = document.getElementById('modalTareaSubtitulo');
            if (sub && etiquetaHu) {
                sub.textContent = 'Asociada a: ' + etiquetaHu;
            }
        }

        function prepararModalEditarTarea(btn) {
            document.getElementById('editIdTarea').value = btn.getAttribute('data-id') || '';
            document.getElementById('editTareaTitulo').value = btn.getAttribute('data-titulo') || '';
            document.getElementById('editTareaDescripcion').value = btn.getAttribute('data-descripcion') || '';
            document.getElementById('editTareaResponsable').value = btn.getAttribute('data-responsable') || '';
            document.getElementById('editTareaPuntos').value = btn.getAttribute('data-puntos') || '3';
            document.getElementById('editTareaHoras').value = btn.getAttribute('data-horas') || '6';
            document.getElementById('editTareaFecha').value = btn.getAttribute('data-fecha') || '';
        }

        function prepararModalEliminarTarea(btn) {
            const id = btn.getAttribute('data-id') || '';
            const titulo = btn.getAttribute('data-titulo') || '';
            document.getElementById('eliminarIdTarea').value = id;
            document.getElementById('eliminarTareaTexto').innerHTML =
                '¿Estás seguro de que deseas eliminar la tarea <strong>' + titulo + '</strong>?';
        }

        function prepararModalCheckpoint(btn) {
            const id = btn.getAttribute('data-id') || '';
            const titulo = btn.getAttribute('data-titulo') || '';
            pctAnteriorModal = parseInt(btn.getAttribute('data-pct') || '0', 10);
            const estado = btn.getAttribute('data-estado') || 'En progreso';

            const form = document.getElementById('formModalCheckpoint');
            if (form) {
                form.setAttribute('data-pct-actual', pctAnteriorModal.toString());
            }

            document.getElementById('chkIdTarea').value = id;
            document.getElementById('modalCheckpointSubtitulo').textContent = 'Tarea #' + id + ': ' + titulo;
            document.getElementById('chkPorcentajeAnteriorTexto').textContent = pctAnteriorModal + '%';
            document.getElementById('chkEstadoAnteriorTexto').textContent = estado;
            document.getElementById('chkPorcentajeNuevo').value = pctAnteriorModal;
            document.getElementById('chkEstadoNuevo').value = estado;
            document.getElementById('chkHorasTrabajadas').value = '2';
            document.getElementById('chkJustificacion').value = '';
            document.getElementById('chkIdImpedimento').value = '';
            document.getElementById('chkAlertaModal').classList.add('d-none');
            document.getElementById('chkAsteriscoJust').classList.add('d-none');
        }

        (function () {
            const formChk = document.getElementById('formModalCheckpoint');
            if (!formChk) return;

            const inputPct = document.getElementById('chkPorcentajeNuevo');
            const selectEstado = document.getElementById('chkEstadoNuevo');
            const alerta = document.getElementById('chkAlertaModal');
            const asterisco = document.getElementById('chkAsteriscoJust');

            function revisarReglas() {
                const nuevo = parseInt(inputPct.value || '0', 10);
                const est = selectEstado.value;
                alerta.classList.add('d-none');

                if (!isNaN(nuevo) && nuevo < pctAnteriorModal) {
                    asterisco.classList.remove('d-none');
                    alerta.classList.remove('d-none');
                    alerta.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Retroceso detectado (' + pctAnteriorModal + '% → ' + nuevo + '%). Es obligatorio ingresar una justificación o vincular un impedimento.';
                } else {
                    asterisco.classList.add('d-none');
                }

                if (est === 'Finalizado' && nuevo !== 100) {
                    alerta.classList.remove('d-none');
                    alerta.innerHTML = '<i class="bi bi-info-circle-fill me-1"></i> Para marcar la tarea como <strong>Finalizado</strong>, el porcentaje de avance debe ser exactamente 100%.';
                }
            }

            selectEstado.addEventListener('change', function () {
                if (selectEstado.value === 'Finalizado') {
                    inputPct.value = '100';
                    if (window.ScrumValidador) window.ScrumValidador.limpiarInvalido(inputPct);
                }
                revisarReglas();
            });

            inputPct.addEventListener('input', function () {
                const nuevo = parseInt(inputPct.value || '0', 10);
                if (nuevo === 100 && selectEstado.value === 'Pendiente') {
                    selectEstado.value = 'Finalizado';
                }
                revisarReglas();
            });
        })();
    </script>
}
