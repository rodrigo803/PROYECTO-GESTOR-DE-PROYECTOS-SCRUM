@model Gestor_proyectos_scrum.Models.EditarTareaViewModel
@{
    ViewData["Title"] = "Editar Tarea";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modulos-rodrigo.css" asp-append-version="true" />
}

@await Html.PartialAsync("_BarraPerfilPruebas")

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-controller="Tareas" asp-action="Index" class="text-decoration-none text-muted">Sprint Backlog &amp; Tareas</a></li>
                <li class="breadcrumb-item"><a asp-controller="Tareas" asp-action="Details" asp-route-id="@Model.IdTarea" class="text-decoration-none text-muted">Tarea #@Model.IdTarea</a></li>
                <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">Editar Metadatos</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <h1 class="page-title mb-0">Editar Metadatos de Tarea #@Model.IdTarea</h1>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">HU-07</span>
        </div>
        <p class="page-subtitle mb-0">Historia asociada: <strong>@Model.HistoriaEtiqueta</strong></p>
    </div>

    <div>
        <a asp-action="Details" asp-route-id="@Model.IdTarea" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i>
            <span>Volver al detalle</span>
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="alert alert-info rounded-3 small d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-shield-check fs-5"></i>
            <div>
                El estado actual (<strong>@Model.EstadoActual</strong>), el avance (<strong>@Model.PorcentajeAvanceActual%</strong>) y las horas reales acumuladas (<strong>@Model.HorasRealesActuales.ToString("0.#") hrs</strong>) solo se modifican mediante <strong>Checkpoints Inmutables</strong> en la vista de detalles.
            </div>
        </div>

        <div class="card-custom p-4">
            <form asp-action="Edit" asp-route-id="@Model.IdTarea" method="post" class="form-validar-scrum" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdTarea" />
                <input type="hidden" asp-for="IdSprintHistoria" />
                <input type="hidden" asp-for="HistoriaEtiqueta" />
                <input type="hidden" asp-for="SprintNombre" />
                <input type="hidden" asp-for="SprintEstado" />
                <input type="hidden" asp-for="PorcentajeAvanceActual" />
                <input type="hidden" asp-for="EstadoActual" />
                <input type="hidden" asp-for="HorasRealesActuales" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Titulo" class="form-label fw-semibold text-dark"></label>
                        <span class="text-danger">*</span>
                        <input asp-for="Titulo"
                               class="form-control"
                               maxlength="150"
                               required
                               data-msg-required="El título de la tarea es obligatorio." />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Descripcion" class="form-label fw-semibold text-dark mb-1"></label>
                            <span id="contadorDescEditPage" class="char-counter">0 / 500</span>
                        </div>
                        <textarea asp-for="Descripcion"
                                  rows="2"
                                  maxlength="500"
                                  data-char-counter="#contadorDescEditPage"
                                  class="form-control"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="IdResponsable" class="form-label fw-semibold text-dark"></label>
                        <select asp-for="IdResponsable" class="form-select">
                            <option value="">-- Sin asignar --</option>
                            @foreach (var r in Model.ResponsablesDisponibles)
                            {
                                <option value="@r.IdUsuario">@r.NombreCompleto (@r.RolNombre)</option>
                            }
                        </select>
                        <span asp-validation-for="IdResponsable" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="FechaEntregaEstimada" class="form-label fw-semibold text-dark"></label>
                        <span class="text-danger">*</span>
                        <input asp-for="FechaEntregaEstimada"
                               type="date"
                               class="form-control"
                               required
                               data-msg-required="La fecha de entrega estimada es obligatoria." />
                        <span asp-validation-for="FechaEntregaEstimada" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="PuntosEsfuerzo" class="form-label fw-semibold text-dark"></label>
                        <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-award text-muted"></i></span>
                            <input asp-for="PuntosEsfuerzo"
                                   type="number"
                                   min="1"
                                   max="100"
                                   class="form-control"
                                   required
                                   data-msg-required="Los puntos de esfuerzo son obligatorios."
                                   data-msg-min="Los puntos de esfuerzo deben ser mayores a 0." />
                            <span class="input-group-text bg-light text-muted small">pts</span>
                        </div>
                        <span asp-validation-for="PuntosEsfuerzo" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="HorasEstimadas" class="form-label fw-semibold text-dark"></label>
                        <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-clock text-muted"></i></span>
                            <input asp-for="HorasEstimadas"
                                   type="number"
                                   step="0.5"
                                   min="0.5"
                                   max="500"
                                   class="form-control"
                                   required
                                   data-msg-required="Las horas estimadas son obligatorias."
                                   data-msg-min="Las horas estimadas deben ser mayores a 0." />
                            <span class="input-group-text bg-light text-muted small">hrs</span>
                        </div>
                        <span asp-validation-for="HorasEstimadas" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.IdTarea" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4">
                        <i class="bi bi-save"></i>
                        <span>Guardar Cambios</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modulos-rodrigo.js" asp-append-version="true"></script>
}
