@model Gestor_proyectos_scrum.Models.PlanificacionClienteViewModel
@{
    ViewData["Title"] = "Compromiso del Sprint";
    Layout = "_LayoutCliente";
    var sprint = Model.Sprint;
}

@functions {
    private static string ClaseEstadoSprint(string estado) => estado switch
    {
        "Activo" => "project-status-activo",
        "Planificado" => "project-status-planificado",
        "Cerrado" => "project-status-cerrado",
        _ => "project-status-planificado"
    };

    private static string ClasePrioridad(string prioridad) => prioridad switch
    {
        "Alta" => "bg-danger-subtle text-danger border border-danger-subtle",
        "Media" => "bg-warning-subtle text-warning border border-warning-subtle",
        _ => "bg-secondary-subtle text-secondary border"
    };

    private static string ClaseAprobacion(string estado) => estado switch
    {
        "Aceptada" => "status-badge-select status-finalizado",
        "Rechazada" => "badge bg-danger-subtle text-danger border border-danger-subtle",
        _ => "status-badge-select status-pendiente"
    };

    private static string ClaseCapacidad(int puntos, int capacidad)
    {
        if (capacidad <= 0) { return "capacity-ok"; }
        var porcentaje = puntos * 100.0 / capacidad;
        if (porcentaje > 100) { return "capacity-over"; }
        return porcentaje >= 80 ? "capacity-warning" : "capacity-ok";
    }
}

<!-- Encabezado de la Pantalla -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item text-muted">Vista Cliente</li>
                <li class="breadcrumb-item active fw-medium" aria-current="page" style="color: var(--client-accent-hover);">Compromiso del Sprint</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="page-title mb-0">Compromiso del Sprint</h1>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">HU-06</span>
            <span class="badge bg-secondary-subtle text-secondary border"><i class="bi bi-eye me-1"></i>Solo consulta</span>
        </div>
        <p class="page-subtitle mb-0">Historias comprometidas en el Sprint y su estado de aprobación.</p>
    </div>
</div>

@if (!Model.Proyectos.Any())
{
    <div class="card-custom p-4 text-center text-muted">
        <i class="bi bi-kanban fs-1 d-block mb-2"></i>
        Todavía no participas en ningún proyecto.
    </div>
}
else
{
    <!-- Selector de Proyecto y Sprint -->
    <div class="card-custom p-3 mb-4">
        <form method="get" asp-action="Cliente" class="d-flex align-items-center gap-2 flex-wrap">
            <label class="small text-muted mb-0" for="selectProyecto">Proyecto</label>
            <select id="selectProyecto" name="idProyecto" class="form-select form-select-sm" style="max-width: 280px;" onchange="this.form.submit()" aria-label="Proyecto">
                @foreach (var p in Model.Proyectos)
                {
                    <option value="@p.IdProyecto" selected="@(p.IdProyecto == Model.IdProyecto)">@p.Codigo &mdash; @p.Nombre</option>
                }
            </select>
            <label class="small text-muted mb-0 ms-md-2" for="selectSprint">Sprint</label>
            @if (Model.Sprints.Any())
            {
                <select id="selectSprint" name="idSprint" class="form-select form-select-sm" style="max-width: 220px;" onchange="this.form.submit()" aria-label="Sprint">
                    @foreach (var s in Model.Sprints)
                    {
                        <option value="@s.IdSprint" selected="@(s.IdSprint == Model.IdSprint)">@s.Nombre (@s.Estado)</option>
                    }
                </select>
            }
            else
            {
                <select id="selectSprint" class="form-select form-select-sm" style="max-width: 220px;" disabled aria-label="Sprint">
                    <option>Sin Sprints disponibles</option>
                </select>
            }
        </form>
    </div>

    @if (sprint is null)
    {
        <div class="card-custom p-4 text-center text-muted">
            <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
            Este proyecto no tiene Sprints.
        </div>
    }
    else
    {
        <!-- Tarjeta Resumen del Sprint -->
        <div class="metric-card mb-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <h5 class="fw-bold text-dark mb-0">@sprint.Nombre</h5>
                    <small class="text-muted">@sprint.FechaInicio.ToString("dd/MM/yyyy") &mdash; @sprint.FechaFin.ToString("dd/MM/yyyy")</small>
                </div>
                <span class="project-status-badge @ClaseEstadoSprint(sprint.Estado)"><span class="status-dot"></span>@sprint.Estado</span>
            </div>
            <p class="small text-muted mb-3">
                @(string.IsNullOrWhiteSpace(sprint.Objetivo) ? "Sin objetivo registrado." : sprint.Objetivo)
            </p>

            <div class="capacity-bar-header">
                <span class="text-muted">Puntos comprometidos</span>
                <span class="capacity-bar-value">@Model.PuntosComprometidos / @sprint.CapacidadPuntos pts</span>
            </div>
            <div class="capacity-bar-track">
                <div class="capacity-bar-fill @ClaseCapacidad(Model.PuntosComprometidos, sprint.CapacidadPuntos)"
                     style="width: @(sprint.CapacidadPuntos > 0 ? Math.Min(100, Model.PuntosComprometidos * 100 / sprint.CapacidadPuntos) : 0)%;"></div>
            </div>
        </div>

        <!-- Historias Comprometidas -->
        <div class="card-custom overflow-hidden">
            <div class="p-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0">Historias comprometidas (@Model.Comprometidas.Count)</h5>
            </div>

            @if (!Model.Comprometidas.Any())
            {
                <p class="text-muted text-center py-4 mb-0">Este Sprint no tiene historias comprometidas.</p>
            }
            else
            {
                <!-- Tabla: escritorio -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="small text-muted">
                                <th>Historia</th>
                                <th>Prioridad</th>
                                <th>Pts</th>
                                <th>Tareas</th>
                                <th>Aprobación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.Comprometidas)
                            {
                                <tr>
                                    <td><strong>@h.Codigo</strong> @h.Quiero</td>
                                    <td><span class="badge @ClasePrioridad(h.Prioridad)">@h.Prioridad</span></td>
                                    <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@(h.Estimacion?.ToString() ?? "-") pts</span></td>
                                    <td class="text-muted">@h.CantidadTareas</td>
                                    <td><span class="@ClaseAprobacion(h.EstadoAprobacion)"><span class="status-dot"></span><span class="status-text">@h.EstadoAprobacion</span></span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Tarjetas: móvil -->
                <div class="d-md-none p-3 d-flex flex-column gap-3">
                    @foreach (var h in Model.Comprometidas)
                    {
                        <div class="card-custom p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div><strong>@h.Codigo</strong> @h.Quiero</div>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle flex-shrink-0 ms-2">@(h.Estimacion?.ToString() ?? "-") pts</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge @ClasePrioridad(h.Prioridad)">@h.Prioridad</span>
                                <small class="text-muted">@h.CantidadTareas tarea(s)</small>
                            </div>
                            <div class="mt-2">
                                <span class="@ClaseAprobacion(h.EstadoAprobacion)"><span class="status-dot"></span><span class="status-text">@h.EstadoAprobacion</span></span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
}
