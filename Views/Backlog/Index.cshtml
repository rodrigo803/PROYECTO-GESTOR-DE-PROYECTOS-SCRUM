@using System.Text.Json
@model Gestor_proyectos_scrum.Models.BacklogVista
@{ ViewData["Title"]="Product Backlog"; bool puedeEditar = (bool)ViewBag.PuedeEditar; }
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-2 mb-3">
 <div><nav class="small mb-1"><a asp-controller="Home" asp-action="Index">Inicio</a> / <span class="text-primary">Gestión del Product Backlog</span></nav><h1 class="page-title mb-0">Gestión del Product Backlog <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6">HU-04</span></h1><p class="page-subtitle">Registra, prioriza y consulta las historias de usuario de cada proyecto.</p></div>
 @if(puedeEditar){<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#historiaModal" id="nuevaHistoria"><i class="bi bi-plus-circle-fill"></i> Nueva historia</button>}
</div>
<div class="alert alert-primary small"><i class="bi bi-info-circle-fill me-2"></i><b>Vista administrativa.</b> Las historias y criterios se cargan desde MySQL.</div>
<form method="get" class="d-flex flex-wrap gap-2 mb-3"><label class="visually-hidden" for="proyectoId">Proyecto</label><select class="form-select form-select-sm" name="proyectoId" id="proyectoId" style="max-width:300px" onchange="this.form.submit()">@foreach(var p in Model.Proyectos){<option value="@p.IdProyecto" selected="@(p.IdProyecto==Model.ProyectoId)">@p.Nombre</option>}</select></form>
<div class="card-custom"><div class="border-bottom p-3 d-flex justify-content-between align-items-center flex-wrap gap-2"><div><h2 class="h6 fw-bold mb-0">Mantenimiento de historias</h2><p class="text-muted small mb-0">Historias registradas en la base de datos</p></div><input id="filtrarHistorias" type="search" class="form-control form-control-sm" placeholder="Buscar historia de usuario" style="max-width:260px"/></div>
<div class="table-responsive"><table class="table table-custom align-middle mb-0"><thead><tr><th>Código</th><th>Historia de usuario</th><th>Prioridad</th><th>Estimación</th><th>Estado</th><th>Criterios</th><th>Acción</th></tr></thead><tbody id="tablaHistorias">
@foreach(var h in Model.Historias){<tr><td><strong>@h.Codigo</strong></td><td style="min-width:280px">Como @h.Como, quiero @h.Quiero, para @h.Para.</td><td><span class="badge @(h.Prioridad=="Alta"?"bg-danger-subtle text-danger":h.Prioridad=="Media"?"bg-warning-subtle text-warning-emphasis":"bg-secondary-subtle text-secondary")">@h.Prioridad</span></td><td>@(h.Estimacion?.ToString()??"—") pts</td><td><span class="badge bg-info-subtle text-info">@h.Estado</span></td><td>@h.TotalCriterios</td><td>
@if(puedeEditar){<div class="d-flex align-items-center gap-2"><button type="button" class="btn btn-link btn-sm p-0 editar-historia" data-id="@h.IdHistoria">Editar</button><form method="post" asp-controller="Backlog" asp-action="Eliminar" onsubmit="return confirm('¿Eliminar la historia?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@h.IdHistoria"/><input type="hidden" name="proyectoId" value="@h.IdProyecto"/><button class="btn btn-link btn-sm text-danger p-0" type="submit">Eliminar</button></form></div>}else{<span class="text-muted small">Consulta</span>}
</td></tr>}
@if(Model.Historias.Count==0){<tr><td colspan="7" class="text-center text-muted p-4">No hay historias para este proyecto.</td></tr>}
</tbody></table></div></div>
@if(puedeEditar){<div class="modal fade" id="historiaModal" tabindex="-1" aria-labelledby="tituloHistoria" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><form method="post" asp-controller="Backlog" asp-action="Guardar">@Html.AntiForgeryToken()<input type="hidden" name="IdHistoria" id="historiaId" value="0"/><input type="hidden" name="IdProyecto" value="@Model.ProyectoId"/><div class="modal-header"><h5 id="tituloHistoria" class="modal-title">Historia de usuario</h5><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><div class="row g-3"><div class="col-sm-4"><label class="form-label">Código</label><input class="form-control" name="Codigo" id="historiaCodigo" maxlength="10" pattern="HU-[0-9]{2,7}" required placeholder="HU-13"/></div><div class="col-sm-4"><label class="form-label">Prioridad</label><select class="form-select" name="Prioridad" id="historiaPrioridad"><option>Alta</option><option>Media</option><option>Baja</option></select></div><div class="col-sm-4"><label class="form-label">Orden de prioridad</label><input class="form-control" type="number" name="OrdenPrioridad" id="historiaOrden" value="1" min="1" required/></div><div class="col-12"><label class="form-label">Como [rol]</label><input class="form-control" name="Como" id="historiaComo" maxlength="100" required/></div><div class="col-12"><label class="form-label">Quiero [funcionalidad]</label><textarea class="form-control" name="Quiero" id="historiaQuiero" maxlength="300" required rows="2"></textarea></div><div class="col-12"><label class="form-label">Para [beneficio]</label><textarea class="form-control" name="Para" id="historiaPara" maxlength="300" required rows="2"></textarea></div><div class="col-sm-6"><label class="form-label">Estimación en puntos</label><input class="form-control" type="number" name="Estimacion" id="historiaEstimacion" min="1"/></div><div class="col-sm-6"><label class="form-label">Estado</label><select class="form-select" name="Estado" id="historiaEstado"><option>Pendiente</option><option>Lista</option><option>En Sprint</option><option>Terminada</option></select></div><div class="col-12"><label class="form-label">Criterios de aceptación (uno por línea)</label><textarea class="form-control" name="CriteriosTexto" id="historiaCriterios" rows="4" placeholder="El usuario puede...&#10;Se valida..."></textarea><small class="text-muted">Para marcar como Lista se necesitan criterios y estimación.</small></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit">Guardar historia</button></div></form></div></div></div>}
@section Scripts {<script>
const historias = @Html.Raw(JsonSerializer.Serialize(Model.Historias));
const campos = {historiaId:'IdHistoria',historiaCodigo:'Codigo',historiaComo:'Como',historiaQuiero:'Quiero',historiaPara:'Para',historiaPrioridad:'Prioridad',historiaOrden:'OrdenPrioridad',historiaEstimacion:'Estimacion',historiaEstado:'Estado',historiaCriterios:'CriteriosTexto'};
document.getElementById('filtrarHistorias')?.addEventListener('input', e=>{const q=e.target.value.toLocaleLowerCase();document.querySelectorAll('#tablaHistorias tr').forEach(tr=>tr.hidden=!tr.innerText.toLocaleLowerCase().includes(q));});
document.getElementById('nuevaHistoria')?.addEventListener('click',()=>{Object.keys(campos).forEach(id=>document.getElementById(id).value=({historiaId:0,historiaPrioridad:'Media',historiaEstado:'Pendiente',historiaOrden:1}[id]??''));});
document.querySelectorAll('.editar-historia').forEach(b=>b.addEventListener('click',()=>{const h=historias.find(x=>x.IdHistoria==b.dataset.id);Object.entries(campos).forEach(([id,key])=>{document.getElementById(id).value=h[key]??'';});bootstrap.Modal.getOrCreateInstance(document.getElementById('historiaModal')).show();}));
</script>}
