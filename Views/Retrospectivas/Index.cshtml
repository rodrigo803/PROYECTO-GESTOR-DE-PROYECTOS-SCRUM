@model Gestor_proyectos_scrum.Models.RetroVista
@{ ViewData["Title"]="Retrospectiva";bool permiso=(bool)ViewBag.PuedeRegistrar;var hoy=DateTime.Today.ToString("yyyy-MM-dd");}
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><nav class="small mb-1"><a asp-controller="Home" asp-action="Index">Inicio</a> / <span class="text-primary">Gestión de Retrospectivas</span></nav><h1 class="page-title mb-0">Gestión de Retrospectivas <span class="badge bg-primary-subtle text-primary fs-6">HU-11</span></h1><p class="page-subtitle">Registra aspectos positivos, oportunidades de mejora y acciones acordadas al cierre de cada Sprint.</p></div><div class="view-switch"><span class="view-switch-option active"><i class="bi bi-display"></i> Administrativa</span><span class="view-switch-option"><i class="bi bi-person"></i> Cliente</span></div></div>
<div class="row g-3"><div class="col-lg-7"><div class="card-custom"><div class="p-3 border-bottom"><h2 class="h6 fw-bold mb-0">Registrar retrospectiva</h2><p class="small text-muted mb-0">Formulario de resultados de la reunión</p></div><form method="post" asp-controller="Retrospectivas" asp-action="Guardar" class="p-3 p-lg-4">@Html.AntiForgeryToken()<fieldset disabled="@(!permiso)"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="retrosprint">Sprint</label><select class="form-select" id="retrosprint" name="Formulario.IdSprint" required>@foreach(var s in Model.Sprints){<option value="@s.IdSprint" selected="@(s.IdSprint==Model.Formulario.IdSprint)">@s.Nombre · @s.Estado</option>}</select></div><div class="col-md-6"><label class="form-label" for="retrofecha">Fecha de reunión</label><input class="form-control" id="retrofecha" name="Formulario.Fecha" type="date" value="@hoy" required/></div><div class="col-12"><label class="form-label" for="positivo">Aspectos positivos</label><textarea id="positivo" class="form-control" name="Formulario.Positivo" rows="2" maxlength="300" required placeholder="¿Qué salió bien durante el Sprint?"></textarea></div><div class="col-12"><label class="form-label" for="mejora">Oportunidades de mejora</label><textarea id="mejora" class="form-control" name="Formulario.Mejora" rows="2" maxlength="300" required placeholder="¿Qué debemos mejorar?"></textarea></div><div class="col-12"><label class="form-label" for="accion">Acciones acordadas</label><textarea id="accion" class="form-control" name="Formulario.Accion" rows="2" maxlength="300" required placeholder="¿Qué acción concreta vamos a realizar?"></textarea></div><div class="col-md-6"><label class="form-label" for="retroresponsable">Responsable de la acción</label><select id="retroresponsable" class="form-select" name="Formulario.IdResponsable"><option value="">Sin asignar</option>@foreach(var u in Model.Responsables){<option value="@u.IdUsuario">@u.Nombre</option>}</select></div><div class="col-md-6"><label class="form-label" for="retroestado">Estado</label><select class="form-select" id="retroestado" name="Formulario.Estado"><option>Pendiente</option><option>En curso</option><option>Cumplida</option></select></div><div class="col-md-6"><label class="form-label" for="retrocompromiso">Fecha de compromiso</label><input class="form-control" name="Formulario.FechaCompromiso" id="retrocompromiso" type="date"/></div></div><div class="d-flex gap-2 pt-3 border-top mt-3"><button type="submit" class="btn btn-primary">Guardar retrospectiva</button><button type="reset" class="btn btn-outline-secondary">Limpiar</button></div></fieldset><p class="text-muted small mt-2 mb-0">Solo Sprints cerrados. Si ya existe una retrospectiva para el Sprint, se actualiza el registro.</p></form></div></div>
<div class="col-lg-5"><div class="card-custom h-100"><div class="p-3 border-bottom"><h2 class="h6 fw-bold mb-0">Retrospectivas anteriores</h2><p class="small text-muted mb-0">Consultas por Sprint (datos reales)</p></div><div class="p-3">@foreach(var retro in Model.Anteriores){<details class="border rounded-3 p-3 mb-2"><summary class="fw-semibold">@retro.Nombre <span class="text-muted fw-normal small">· @retro.Fecha.ToString("dd/MM/yyyy")</span></summary><div class="small mt-2"><p><b>Facilitó:</b> @retro.Facilitador</p><p><b>Aspectos positivos:</b> @retro.Positivo</p><p><b>Oportunidades de mejora:</b> @retro.Mejora</p><p><b>Acciones acordadas:</b> @retro.Accion</p><span class="badge bg-success-subtle text-success">@(retro.EstadoAccion??"Registrada")</span></div></details>}@if(!Model.Anteriores.Any()){<p class="text-muted small">Todavía no hay retrospectivas registradas.</p>}</div></div></div></div>
