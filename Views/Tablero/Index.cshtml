@model Gestor_proyectos_scrum.Models.TableroVista
@{ViewData["Title"]="Tablero Kanban";var estados=new[]{"Pendiente","En progreso","En revisión","Finalizado"};}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><nav class="small mb-1"><a href='@Url.Content("~/Home/Index")'>Inicio</a> / <span class="text-primary">Supervisión del Tablero Kanban</span></nav><h1 class="page-title mb-0">Supervisión del Tablero Kanban <span class="badge bg-primary-subtle text-primary fs-6">HU-08</span></h1><p class="page-subtitle">Consulta el flujo real de tareas del Sprint y actualiza su avance.</p></div><div class="view-switch"><span class="view-switch-option active"><i class="bi bi-display"></i> Administrativa</span><span class="view-switch-option"><i class="bi bi-person"></i> Cliente</span></div></div>
<div class="alert alert-primary small"><i class="bi bi-info-circle-fill me-2"></i><strong>Vista administrativa.</strong> Arrastra las tareas entre estados o abre una tarjeta para registrar avances y responsables en la base de datos.</div>
<div class="d-flex gap-2 flex-wrap mb-3"><form method="get"><select name="sprintId" aria-label="Seleccionar Sprint" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width:240px"><option disabled="@(Model.Sprints.Count>0)" value="">Selecciona un Sprint</option>@foreach(var s in Model.Sprints){<option value="@s.IdSprint" selected="@(s.IdSprint==Model.SprintId)">@s.Nombre (@s.Estado)</option>}</select></form><select id="filtroResponsable" class="form-select form-select-sm" style="max-width:220px"><option value="">Responsable: Todos</option>@foreach(var u in Model.Responsables){<option value="@u.IdUsuario">@u.Nombre</option>}</select><span class="badge bg-secondary-subtle text-secondary align-self-center">Control de tareas en MySQL</span></div>
@Html.AntiForgeryToken()
<div class="row g-3 mb-4" id="kanbanBoard">
@foreach(var estado in estados){var tareas=Model.Tareas.Where(t=>t.Estado==estado).ToList();var clase=estado=="Pendiente"?"warning":estado=="En progreso"?"info":estado=="En revisión"?"purple":"success";
<div class="col-md-6 col-xl-3"><div class="kanban-column h-100" data-estado="@estado"><div class="kanban-column-head"><span class="km-status km-@clase">● @estado</span><span class="badge bg-white text-secondary border">@tareas.Count</span></div><div class="kanban-dropzone" data-drop="@estado">
@foreach(var t in tareas){<article class="kanban-task p-3 mb-2 bg-white border rounded-3 shadow-sm" tabindex="0" role="button" draggable="true" data-task="@t.IdTarea" data-responsable="@t.IdResponsable" data-avance="@t.PorcentajeAvance" data-estado="@t.Estado" data-bs-toggle="modal" data-bs-target="#detalle-@t.IdTarea"><span class="badge @(t.Prioridad=="Alta"?"bg-danger-subtle text-danger":t.Prioridad=="Media"?"bg-warning-subtle text-warning-emphasis":"bg-secondary-subtle text-secondary") mb-2">@t.Prioridad</span><div class="fw-semibold small text-dark mb-1">@t.Titulo</div><div class="small text-muted">Historia @t.Codigo · @t.Quiero</div><hr class="my-2"/><div class="d-flex justify-content-between align-items-center small"><span>@t.PuntosEsfuerzo puntos</span><strong title="Tareas completadas de la historia">@t.TareasTerminadas/@t.TotalTareas <i class="bi bi-check2-square"></i></strong></div><div class="progress mt-2" role="progressbar" aria-label="Avance de tarea" aria-valuenow="@t.PorcentajeAvance" aria-valuemin="0" aria-valuemax="100" style="height:5px"><div class="progress-bar" style="width:@(t.PorcentajeAvance)%"></div></div><div class="text-muted small mt-2">@t.PorcentajeAvance% · @(t.Responsable??"Sin asignar")</div></article>}
</div></div></div>}
</div>
<div class="row g-3"><div class="col-lg-6"><div class="card-custom p-3"><h2 class="h6 fw-bold">Resumen por estado</h2><p class="small text-muted">Cifras reales de las tareas del Sprint</p><div class="d-flex flex-wrap gap-2">@foreach(var estado in estados){<span class="km-status km-@(estado=="Pendiente"?"warning":estado=="En progreso"?"info":estado=="En revisión"?"purple":"success")">@estado: @Model.Tareas.Count(t=>t.Estado==estado)</span>}</div></div></div><div class="col-lg-6"><div class="card-custom p-3"><h2 class="h6 fw-bold">Acciones administrativas</h2><p class="small text-muted">Selecciona una tarea para asignar responsables o registrar avance</p><span class="text-muted small">Se guarda en Tareas, AvanceTareas y Auditoria.</span></div></div></div>
@foreach(var t in Model.Tareas){var hermanas=Model.Tareas.Where(x=>x.IdSprintHistoria==t.IdSprintHistoria).ToList();<div class="modal fade" id="detalle-@t.IdTarea" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><h5 class="modal-title">@t.Codigo · @t.Titulo</h5><small class="text-muted">Como @t.Como, quiero @t.Quiero, para @t.Para</small></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><p class="mb-1"><strong>Descripción:</strong> @(t.Descripcion??"Sin descripción")</p><p class="mb-3 small text-muted">@t.PuntosEsfuerzo puntos de esfuerzo · @t.HorasReales/@t.HorasEstimadas horas · Avance actual: @t.PorcentajeAvance%</p>
<div class="row g-3"><div class="col-md-5"><div class="card border-0 bg-light p-3 h-100"><h6 class="fw-bold">Asignar tarea</h6><label for="responsable-@t.IdTarea" class="form-label small">Responsable</label><select id="responsable-@t.IdTarea" class="form-select form-select-sm" name="responsable"><option value="">Sin asignar</option>@foreach(var u in Model.Responsables){<option value="@u.IdUsuario" selected="@(t.IdResponsable==u.IdUsuario)">@u.Nombre</option>}</select><button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="asignarTarea(@t.IdTarea)">Guardar responsable</button></div></div>
<div class="col-md-7"><div class="card border-0 bg-light p-3 h-100"><h6 class="fw-bold">Registrar avance</h6><label class="small form-label">Estado</label><select id="estado-@t.IdTarea" class="form-select form-select-sm mb-2">@foreach(var e in estados){<option value="@e" selected="@(t.Estado==e)">@e</option>}</select><label class="small form-label">Porcentaje de avance</label><input type="number" id="porcentaje-@t.IdTarea" class="form-control form-control-sm mb-2" min="0" max="100" value="@t.PorcentajeAvance"/><label class="small form-label">Horas trabajadas adicionales</label><input type="number" id="horas-@t.IdTarea" class="form-control form-control-sm mb-2" min="0" step="0.5" value="0"/><label class="small form-label">Justificación (obligatoria si disminuye el avance)</label><textarea id="justificacion-@t.IdTarea" maxlength="300" class="form-control form-control-sm" rows="2"></textarea><button class="btn btn-primary btn-sm mt-2" type="button" onclick="guardarAvance(@t.IdTarea)">Guardar avance</button></div></div></div>
<hr/><h6 class="fw-bold">Checklist de tareas de la historia <span class="badge text-bg-light">@t.TareasTerminadas/@t.TotalTareas</span></h6><p class="small text-muted">Marca las tareas finalizadas. El contador se calcula automáticamente.</p>
@foreach(var hermana in hermanas){<label class="d-flex gap-2 align-items-center border-bottom py-2"><input type="checkbox" class="form-check-input" onchange="marcarTarea(@hermana.IdTarea,this.checked,@hermana.PorcentajeAvance)" checked="@(hermana.Estado=="Finalizado")"/><span class="flex-grow-1">@hermana.Titulo</span><small class="text-muted">@(hermana.Responsable??"Sin asignar")</small></label>}
</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button></div></div></div></div>}
@section Scripts {<script src="~/js/kanban-jesus.js" asp-append-version="true"></script><script>
window.kanbanUrls = {mover:'@Url.Content("~/Tablero/Mover")',asignar:'@Url.Content("~/Tablero/Asignar")'};
</script>}
