@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string EsActivo(string controlador) => controladorActual.Equals(controlador, StringComparison.OrdinalIgnoreCase) ? " active" : "";
}

<!-- ========================================== -->
<!-- SIDEBAR ADMINISTRATIVO                      -->
<!-- ========================================== -->
<aside class="admin-sidebar" id="adminSidebar">

    <div class="sidebar-heading">Navegación Principal</div>
    <nav class="nav flex-column mb-3">
        <a class="sidebar-nav-link@(EsActivo("Home"))" href='@Url.Content("~/Home/Index")'>
            <i class="bi bi-grid-1x2"></i>
            <span>Dashboard</span>
        </a>
        <a class="sidebar-nav-link@(EsActivo("Usuarios"))" href='@Url.Content("~/Usuarios/Index")'>
            <i class="bi bi-people"></i>
            <span>Gestión de Usuarios</span>
        </a>
        <a class="sidebar-nav-link@(EsActivo("Proyectos"))" href='@Url.Content("~/Proyectos/Index")'>
            <i class="bi bi-kanban"></i>
            <span>Gestión de Proyectos</span>
        </a>
        <a class="sidebar-nav-link@(EsActivo("Backlog"))" href='@Url.Content("~/Backlog/Index")'>
            <i class="bi bi-journal-text"></i>
            <span>Product Backlog</span>
        </a>
        <a class="sidebar-nav-link@(EsActivo("Sprints"))" href='@Url.Content("~/Sprints/Index")'>
            <i class="bi bi-arrow-repeat"></i>
            <span>Gestión de Sprints</span>
        </a>
        <a class="sidebar-nav-link@(EsActivo("Planificacion"))" href='@Url.Content("~/Planificacion/Index")'>
            <i class="bi bi-calendar2-week"></i>
            <span>Planificación del Sprint</span>
        </a>
        <a class="sidebar-nav-link@(EsActivo("Tareas"))" href='@Url.Content("~/Tareas/Index")'>
            <i class="bi bi-card-checklist"></i>
            <span>Sprint Backlog</span>
        </a>
        <a class="sidebar-nav-link@(EsActivo("Tablero"))" href='@Url.Content("~/Tablero/Index")'>
            <i class="bi bi-columns-gap"></i>
            <span>Tablero Kanban</span>
        </a>
        <a class="sidebar-nav-link@(EsActivo("Impedimentos"))" href='@Url.Content("~/Impedimentos/Index")'>
            <i class="bi bi-cone-striped"></i>
            <span>Impedimentos</span>
        </a>
        <a class="sidebar-nav-link@(EsActivo("Retrospectivas"))" href='@Url.Content("~/Retrospectivas/Index")'>
            <i class="bi bi-chat-square-text"></i>
            <span>Retrospectiva</span>
        </a>
    </nav>

    <!-- Botón Cerrar Sesión en pie del Sidebar -->
    <div class="mt-auto px-3 pt-4">
        <form method="post" action='@Url.Content("~/Acceso/Salir")'>@Html.AntiForgeryToken()
          <button class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-2" type="submit">
            <i class="bi bi-box-arrow-right"></i><span>Cerrar sesión</span>
          </button>
        </form>
    </div>

</aside>
